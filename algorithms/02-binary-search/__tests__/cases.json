[
	{
		"name": "Target exists in the middle",
		"arr": [10, 20, 30, 40, 50],
		"target": 30,
		"expected": true
	},
	{
		"name": "Target is the first element",
		"arr": [10, 20, 30],
		"target": 10,
		"expected": true
	},
	{
		"name": "Target is the last element",
		"arr": [1, 2, 3, 99],
		"target": 99,
		"expected": true
	},
	{
		"name": "Target does not exist",
		"arr": [2, 4, 6, 8, 10],
		"target": 5,
		"expected": false
	},
	{
		"name": "Target out of bounds (less)",
		"arr": [5, 10, 15],
		"target": 1,
		"expected": false
	},
	{
		"name": "Target out of bounds (greater)",
		"arr": [5, 10, 15],
		"target": 20,
		"expected": false
	},
	{
		"name": "Empty array",
		"arr": [],
		"target": 5,
		"expected": false
	}
]
